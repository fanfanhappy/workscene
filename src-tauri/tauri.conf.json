{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkScene",
  "version": "2.0.4",
  "identifier": "com.workscene.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WorkScene",
    "copyright": "Copyright © 2026 WorkScene",
    "category": "Utility",
    "shortDescription": "保存并恢复整个 Windows 工作现场",
    "longDescription": "WorkScene 把应用、窗口布局、显示器配置保存为可复用的工作空间，需要时一键恢复，并给出可诊断的恢复报告。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
