{
  "manifest_version": 3,
  "name": "WorkScene 浏览器标签页",
  "version": "1.0.0",
  "description": "把当前浏览器窗口和标签页 URL 同步给本机 WorkScene；不联网、不上传。",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WorkScene 浏览器标签页",
    "default_popup": "popup.html"
  }
}
